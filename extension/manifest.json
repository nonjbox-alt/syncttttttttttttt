{
  "manifest_version": 2,
  "name": "SyncRoom Firefox Media Bridge",
  "version": "0.1.0",
  "description": "Keeps private HLS/media playback on the user's Firefox tab while SyncRoom synchronizes playback controls.",
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "SyncRoom Media Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": "script-src 'self'; object-src 'self'"
}
