{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/ws.ts": {
      "includeFiles": "dist/server.cjs"
    },
    "api/[...path].ts": {
      "includeFiles": "dist/server.cjs"
    }
  },
  "rewrites": [
    { "source": "/room/:path*", "destination": "/index.html" }
  ]
}
